# 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# 应用配置
APP_NAME=EmailBulkSending
APP_ENV=development
DEBUG=true

# 安全密钥（生产环境务必更换！）
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
AES_KEY=change-me-to-32-bytes-aes-key-123456

# JWT 配置
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# 数据库
DATABASE_URL=sqlite:///./data/email_bulk.db

# Redis
REDIS_URL=redis://redis:6379/0

# 文件上传
UPLOAD_DIR=./uploads
MAX_ATTACHMENT_SIZE_MB=25
MAX_IMAGE_SIZE_MB=5

# 追踪域名（用于打开率/点击率追踪）
TRACKING_DOMAIN=http://localhost:8000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# 速率限制
LOGIN_RATE_LIMIT=5/minute
TASK_RATE_LIMIT=10/minute
