# 环境变量配置模板
# 复制此文件为 .env 并填入实际值
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env

# 应用配置
APP_NAME=EmailBulkSending
# 生产部署请设为 production（会强制校验密钥强度、关闭调试与文档）
APP_ENV=development
DEBUG=true
ENABLE_DOCS=true
# 速率限制存储：auto=Redis 可用则用 Redis，否则内存兜底；redis=强制 Redis；memory=仅内存
RATE_LIMIT_BACKEND=auto
RATE_LIMIT_REDIS_PREFIX=email-bulk:rate-limit
RATE_LIMIT_REDIS_TIMEOUT=0.2
POSTGRES_PASSWORD=replace-with-a-long-random-password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# 安全密钥（生产环境务必更换！至少 32 位随机字符）
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
AES_KEY=change-me-to-32-bytes-aes-key-123456

# JWT 配置
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# 首次启动自动创建的管理员账号（仅当数据库为空时生效；生产环境务必修改默认密码）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@example.com

# 是否开放自助注册（生产环境建议 false，由管理员在“用户管理”创建账号）
ALLOW_REGISTER=true
REGISTER_RATE_LIMIT=10/hour

# 数据库（生产 Compose 会用 PostgreSQL，无需修改此项）
DATABASE_URL=sqlite:///./data/email_bulk.db

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# 文件上传
UPLOAD_DIR=./uploads
MAX_ATTACHMENT_SIZE_MB=25
MAX_IMAGE_SIZE_MB=5
ATTACHMENT_CACHE_MB=64

# 追踪域名（用于打开率/点击率追踪，请改为你的实际访问域名）
TRACKING_DOMAIN=http://localhost:80

# CORS（允许的跨域来源，多个用英文逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# 速率限制
LOGIN_RATE_LIMIT=5/minute
TASK_RATE_LIMIT=10/minute
